[alias]
  bl = branch --list
  ch = checkout
  db = branch -D
  dd = "!f() { git branch -D \"$1\" && git branch -d -r origin/\"$1\"; }; f"
  drb = "!f() { git branch -d -r origin/\"$1\"; }; f"
  lg = log --oneline --decorate --all --graph --pretty=format:'%C(blue bold)%h %Creset%C(yellow bold)%d %Creset%s %C(red bold)(%ae)%Creset%C(blue bold)[%ad]'
  new = "!f() { git init && git symbolic-ref HEAD refs/heads/\"$1\" && touch .gitignore .gitattributes && echo \"node_modules\" >> .gitignore && git add . && git commit -m \"Init\"; }; f"
  oops = checkout --
  pt = "!f() { git push origin $(git rev-parse --abbrev-ref HEAD); }; f"
  ri = "!f() { git rebase -i HEAD~\"$1\"; }; f"
  s = status -sb
  st = "!f() { git for-each-ref --sort=creatordate --format='| %(creatordate:short) | %(refname:lstrip=2)\t|%(if)%(taggeremail)%(then) %(taggeremail)%(else) %(authoremail)%(end)\t|' refs/tags; }; f | column -t"
  ub = "!f() { git fetch origin && git rebase origin/\"$1\"; }; f"
  unadd = reset HEAD --
[core]
  editor = nvim
  autocrlf = input
[user]
  name = Rodrigo Patiño
  email = {{ .email | quote }}
[color]
  branch = auto
  diff = auto
  status = auto

[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green

[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red bold
  new = green bold

[color "status"]
  added = yellow
  changed = green
  untracked = cyan

[init]
  defaultBranch = main

# Diff with delta
[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)
    line-numbers = true
    navigate = true    # use n and N to move between diff sections
    side-by-side = true
    theme = gruvbox-dark

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

